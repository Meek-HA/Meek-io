    {
        "id": "ba93863fcd88a3dc",
        "type": "function",
        "z": "70084345e983252d",
        "name": "Build tcpconnect Payload",
        "func": "const ip = (msg.payload || '').trim().split(' ')[0];\nconst parts = ip.split('.');\n\nif (parts.length !== 4) {\n    node.error('Invalid host IP: ' + ip, msg);\n    return null;\n}\n\nconst lastOctet = parts[3];\n\nmsg.topic = 'cmnd/Meek_Zigbee/tcpconnect';\nmsg.payload = lastOctet + '02,mqtt.meek-io.com';\n\nreturn msg;",
