        "type": "function",
        "z": "70084345e983252d",
        "name": "Validate LWT State",
        "func": "const state = (msg.payload || '').trim().toLowerCase();\n\nif (state !== 'online' && state !== 'offline') {\n    return null;\n}\n\nmsg.payload = state === 'online' ? 'Online' : 'Offline';\n\nreturn msg;",
