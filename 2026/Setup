Home-Assiatnt Docker-compose:
----------------------------
services:
  homeassistant:
    container_name: homeassistant
    image: "ghcr.io/home-assistant/home-assistant:stable"
    volumes:
      - /meek-io/home-assistant:/config
      - /etc/localtime:/etc/localtime:ro
      - /run/dbus:/run/dbus:ro
    restart: unless-stopped
    stop_grace_period: 60s
    privileged: true
    network_mode: host
    environment:
      TZ: Europe/Amsterdam
----------------------------
Nginx compatibility:
----------------------------
Add the following lines in : .storage/http
"use_x_forwarded_for": true,
"trusted_proxies": ["10.10.10.100"],
----------------------------
Install hacks (docker HA enviroment):
----------------------------
wget -O - https://get.hacs.xyz | bash -
----------------------------
NPM Blocks Home-Assistant:
----------------------------
NPM enable :
- Block Common Exploits
- Websockets Support
- Forse SSL
- HSTS Enabled
- HTTP/2 Support
Create SSL certificate
----------------------------



Zigbee2MQTT section:
----------------------------
docker network create iot-network
----------------------------
Docker-Compose:
----------------------------
services:
    zigbee2mqtt:
        container_name: zigbee2mqtt
        image: ghcr.io/koenkk/zigbee2mqtt:latest
        restart: unless-stopped
        volumes:
            - /meek-io/zigbee2mqtt:/app/data
            - /run/udev:/run/udev:ro
        ports:
            - 8080:8080
        environment:
            - TZ=Europe/Berlin
        
        devices:
            - /dev/ttyESP0:/dev/ttyESP0

----------------------------
Socat:
----------------------------
apt update && sudo apt install -y socat
nano /etc/systemd/system/esp32-serial-bridge.service
----------------------------
[Unit]
Description=ESP32 Zigbee Reverse Serial Bridge
After=network.target

[Service]
Type=simple
# Listens on port 2000, links it to /dev/ttyESP0, and enables TCP keepalives to drop dead ghost links
ExecStart=/usr/bin/socat -d -d PTY,link=/dev/ttyESP0,raw,echo=0,mode=660,group=dialout TCP-LISTEN:2000,reuseaddr,keepalive,keepidle=10,keepintvl=5,keepcnt=3
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
----------------------------
systemctl daemon-reload
systemctl enable --now esp32-serial-bridge.service
----------------------------
nano /meek-io/zigbee2mqtt/configuration.yaml
----------------------------
version: 5
mqtt:
  base_topic: zigbee2mqtt
  server: mqtt://10.10.10.104:1883
  version: 5
  enable_external_js: false
frontend:
  enabled: true
  port: 8080
  auth_token: "xxxPASSWORDxxx"
homeassistant:
  enabled: true
onboarding: false
serial:
  port: /dev/ttyESP0
  adapter: zstack
  baudrate: 115200
  rtscts: false
advanced:
  pan_id: 6754
  ext_pan_id:
    - 0
    - 18
    - 75
    - 0
    - 38
    - 209
    - 74
    - 105
  channel: 11
----------------------------

MQTT:
----------------------------
version: "3.7"
services:
  # mqtt5 eclipse-mosquitto
  mqtt5:
    image: eclipse-mosquitto
    container_name: mosquitto
    ports:
      - "1883:1883" #default mqtt port
      - "8883:8883" #default mqtt port for websockets
    volumes:
      - /meek-io/mosquitto/config:/mosquitto/config:rw
      - /meek-io/mosquitto/data:/mosquitto/data:rw
      - /meek-io/mosquitto/log:/mosquitto/log:rw
    restart: unless-stopped
    networks:
      - iot-network

networks:
    iot-network:
        external: true
----------------------------
nano mosquitto.conf
----------------------------
allow_anonymous true
listener 1883

listener 8883
certfile /mosquitto/config/server.crt
keyfile /mosquitto/config/server.key
----------------------------

----------------------------
NODE-RED
----------------------------
nano /meek-io/node-red/settings.js
----------------------------
adminAuth: {
    type: "credentials",
    users: [
        {
            username: process.env.NODE_RED_ADMIN_USER || "admin",
            // Dynamically hash the plain-text password at boot time:
            password: require('bcryptjs').hashSync(process.env.NODE_RED_ADMIN_PASSWORD || "default_fallback_password", 8),
            permissions: "*"
        }
    ]
},
----------------------------
version: "3.7"

services:
  node-red:
    image: nodered/node-red:latest
    user: "1000:1000" # Or explicitly '1000:1000'
    environment:
      - TZ=Europe/Amsterdam
      - NODE_RED_ADMIN_USER=xxxUSERNAMExxx
      - NODE_RED_ADMIN_PASSWORD=xxxPASSWORDxxx
    ports:
      - "1880:1880"
    volumes:
      - /meek-io/node-red:/data
    restart: always

networks:
    iot-network:
        external: true
----------------------------
chown -R 1000:1000 /meek-io/node-red
----------------------------
